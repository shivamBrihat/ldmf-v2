# Admin Authentication Configuration
ADMIN_USERNAME=admin
# Generate a bcrypt hash using: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here
# Generate a 32+ character random secret string
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (e.g. mongodb+srv://...)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ldmf_db?retryWrites=true&w=majority"
